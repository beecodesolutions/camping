{
  "name": "camping",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "pnpm --filter @camping/ui dev",
    "build": "pnpm --filter @camping/ui build",
    "preview": "pnpm --filter @camping/ui preview",
    "lint": "pnpm --filter @camping/ui lint",
    "typecheck": "pnpm --filter @camping/ui typecheck",
    "test": "pnpm --filter @camping/ui test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
