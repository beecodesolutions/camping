# Local API/runtime connection. Production uses the least-privilege role.
DATABASE_URL=postgresql://camping:camping-local-only@localhost:5434/camping
# Optional administrative connection used only by migration, seed, user, and role-provisioning CLIs.
DATABASE_ADMIN_URL=
DATABASE_SSL=false
DB_SCHEMA=camping_private
DB_POOL_MAX=2
DB_CONNECTION_TIMEOUT_MS=10000

ALLOWED_ORIGIN=http://localhost:5173
REQUIRE_ORIGIN=false
PORT=3000
HOST=127.0.0.1

# CLI-only inputs. Prefer --password-stdin so passwords do not remain in the environment.
CAMPING_KEY=la-izuelina
DATABASE_RUNTIME_ROLE=camping_runtime
